{
  "manifest_version": 3,
  "name": "Not A Limit",
  "version": "1.2.0",
  "description": "Rewrites OpenAI's spend limit pages to say what they actually mean: without \"Enforce a hard limit\", your spend limit is decoration.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://platform.openai.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
